{
  "info": {
    "name": "ExcelApi",
    "_postman_id": "excelapi-collection-v1",
    "description": "ExcelApi - Excel dosyası yükleyip MySQL'e kaydeden API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5054",
      "type": "string"
    },
    {
      "key": "jobId",
      "value": "",
      "type": "string",
      "description": "Excel Upload isteğinden dönen jobId; 'Excel Upload' isteği çalıştırıldığında test script'i tarafından otomatik doldurulur."
    }
  ],
  "item": [
    {
      "name": "Excel Upload",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 202) {",
              "    const jsonData = pm.response.json();",
              "    pm.collectionVariables.set('jobId', jsonData.jobId);",
              "    console.log('jobId kaydedildi:', jsonData.jobId);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/excel/upload",
          "host": ["{{baseUrl}}"],
          "path": ["api", "excel", "upload"]
        },
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": "",
              "description": "Yüklenecek Excel dosyası (.xlsx)"
            },
            {
              "key": "type",
              "value": "1",
              "type": "text",
              "description": "Rapor tipi (int). Örn: 1, 2, 3..."
            }
          ]
        },
        "description": "Excel dosyasını yükler. Dosya hemen okunur ve işlem arka planda (background job) başlatılır; istek anında 202 Accepted ile bir jobId döner - render + DB işlemi uzun sürebildiği için (yüzlerce kayıtta 10+ dakika) artık senkron beklenmez, böylece gateway/proxy timeout (504) alınmaz. İşlemin durumunu takip etmek için dönen jobId ile 'Get Upload Status' isteğini poll edin, veya ham log akışı için 'Get Upload Log' isteğini kullanın."
      },
      "response": [
        {
          "name": "202 Accepted - Job başlatıldı",
          "status": "Accepted",
          "code": 202,
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": "{\n  \"jobId\": \"3f2b1c4d5e6f7890abcdef1234567890\",\n  \"statusUrl\": \"/api/excel/upload/status/3f2b1c4d5e6f7890abcdef1234567890\",\n  \"message\": \"Yükleme kabul edildi, arka planda işleniyor.\"\n}",
          "_postman_previewlanguage": "json"
        },
        {
          "name": "400 Bad Request - Dosya Yok",
          "status": "Bad Request",
          "code": 400,
          "body": "Dosya yüklenmedi",
          "_postman_previewlanguage": "text"
        },
        {
          "name": "500 Internal Server Error",
          "status": "Internal Server Error",
          "code": 500,
          "body": "Sunucu hatası: <hata mesajı>",
          "_postman_previewlanguage": "text"
        }
      ]
    },
    {
      "name": "Get Upload Status",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/excel/upload/status/{{jobId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "excel", "upload", "status", "{{jobId}}"]
        },
        "description": "'Excel Upload' isteğinden dönen jobId ile işlemin durumunu döner (Pending/Processing/Completed/Failed). 'Excel Upload' isteği başarıyla çalıştırıldığında {{jobId}} collection değişkeni otomatik güncellenir; bu isteği Completed veya Failed görene kadar tekrar tekrar çalıştırın (poll edin)."
      },
      "response": [
        {
          "name": "200 OK - Processing",
          "status": "OK",
          "code": 200,
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": "{\n  \"id\": \"3f2b1c4d5e6f7890abcdef1234567890\",\n  \"status\": \"Processing\",\n  \"total\": 312,\n  \"processed\": 120,\n  \"percent\": 38.5,\n  \"result\": null,\n  \"error\": null,\n  \"createdAt\": \"2026-07-31T13:00:10.123\",\n  \"completedAt\": null\n}",
          "_postman_previewlanguage": "json"
        },
        {
          "name": "200 OK - Completed",
          "status": "OK",
          "code": 200,
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": "{\n  \"id\": \"3f2b1c4d5e6f7890abcdef1234567890\",\n  \"status\": \"Completed\",\n  \"total\": 429,\n  \"processed\": 429,\n  \"percent\": 100,\n  \"result\": [\n    { \"id\": \"00000.12345\" },\n    { \"id\": \"00000.67890\" }\n  ],\n  \"error\": null,\n  \"createdAt\": \"2026-07-31T13:00:10.123\",\n  \"completedAt\": \"2026-07-31T13:14:53.671\"\n}",
          "_postman_previewlanguage": "json"
        },
        {
          "name": "200 OK - Failed",
          "status": "OK",
          "code": 200,
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": "{\n  \"id\": \"3f2b1c4d5e6f7890abcdef1234567890\",\n  \"status\": \"Failed\",\n  \"total\": 312,\n  \"processed\": 45,\n  \"percent\": 14.4,\n  \"result\": null,\n  \"error\": \"Gerekli sayfalar bulunamadı.\",\n  \"createdAt\": \"2026-07-31T13:00:10.123\",\n  \"completedAt\": \"2026-07-31T13:01:02.001\"\n}",
          "_postman_previewlanguage": "json"
        },
        {
          "name": "404 Not Found - Job bulunamadı",
          "status": "Not Found",
          "code": 404,
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": "{\n  \"message\": \"Job bulunamadı.\"\n}",
          "_postman_previewlanguage": "json"
        }
      ]
    },
    {
      "name": "Get Upload Log",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/excel/log?lines=300",
          "host": ["{{baseUrl}}"],
          "path": ["api", "excel", "log"],
          "query": [
            {
              "key": "lines",
              "value": "300",
              "description": "Dosyanın sondan kaç satırının döneceği (varsayılan 300)"
            }
          ]
        },
        "description": "upload_debug.log dosyasının son satırlarını döner. Upload arka planda işlenirken sunucuda en son hangi aşamaya (parse/render/DB connect/insert/commit) kadar gelindiğini görmek için 'Get Upload Status' isteğine ek olarak, ham log akışını incelemek amacıyla çağrılabilir."
      },
      "response": [
        {
          "name": "200 OK - Log içeriği",
          "status": "OK",
          "code": 200,
          "header": [
            {
              "key": "Content-Type",
              "value": "text/plain; charset=utf-8"
            }
          ],
          "body": "30.07.2026 10:50:12.345 - [Request] UploadExcel çağrıldı. JobId: 3f2b1c4d5e6f7890abcdef1234567890, Dosya: BAYI KARNE.xlsx, Boyut: 245678 bytes, Type: 5\n30.07.2026 10:50:12.410 - [3f2b1c4d5e6f7890abcdef1234567890] Parse tamamlandı (65ms). İşlenecek kayıt sayısı: 312\n30.07.2026 10:50:12.411 - [3f2b1c4d5e6f7890abcdef1234567890] Render döngüsü başladı.\n30.07.2026 10:50:15.200 - [3f2b1c4d5e6f7890abcdef1234567890] 10/312 kayıt render edildi. Son ID: 00000.12345 (geçen süre: 2789ms)\n30.07.2026 10:52:40.500 - DB: bağlantı açılıyor (conn.Open)...",
          "_postman_previewlanguage": "text"
        },
        {
          "name": "200 OK - Log henüz yok",
          "status": "OK",
          "code": 200,
          "body": "Log dosyası henüz oluşmadı.",
          "_postman_previewlanguage": "text"
        },
        {
          "name": "500 Internal Server Error",
          "status": "Internal Server Error",
          "code": 500,
          "body": "Log okunamadı: <hata mesajı>",
          "_postman_previewlanguage": "text"
        }
      ]
    },
    {
      "name": "Clear Upload Log",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/excel/log/clear",
          "host": ["{{baseUrl}}"],
          "path": ["api", "excel", "log", "clear"]
        },
        "description": "upload_debug.log dosyasının içeriğini temizler."
      },
      "response": [
        {
          "name": "200 OK - Temizlendi",
          "status": "OK",
          "code": 200,
          "body": "Log temizlendi.",
          "_postman_previewlanguage": "text"
        },
        {
          "name": "500 Internal Server Error",
          "status": "Internal Server Error",
          "code": 500,
          "body": "Log temizlenemedi: <hata mesajı>",
          "_postman_previewlanguage": "text"
        }
      ]
    }
  ]
}
