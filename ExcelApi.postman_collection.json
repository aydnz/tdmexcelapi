{
  "info": {
    "name": "ExcelApi",
    "_postman_id": "excelapi-collection-v1",
    "description": "ExcelApi - Excel dosyası yükleyip MySQL'e kaydeden API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5054",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Excel Upload",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/excel/upload",
          "host": ["{{baseUrl}}"],
          "path": ["api", "excel", "upload"]
        },
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": "",
              "description": "Yüklenecek Excel dosyası (.xlsx)"
            },
            {
              "key": "type",
              "value": "1",
              "type": "text",
              "description": "Rapor tipi (int). Örn: 1, 2, 3..."
            }
          ]
        },
        "description": "Excel dosyasını yükler. PARAKENDECİLİK(KARNE) ve bayi-personel sayfalarını işler, her satır için karne görselini base64'e çevirir ve tbl_reports tablosuna kaydeder."
      },
      "response": [
        {
          "name": "200 OK - Başarılı",
          "status": "OK",
          "code": 200,
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": "[\n  {\n    \"id\": \"00000.12345\",\n    \"base64\": \"iVBORw0KGgoAAAANSUhEUgAA...\"\n  },\n  {\n    \"id\": \"00000.67890\",\n    \"base64\": \"iVBORw0KGgoAAAANSUhEUgAA...\"\n  }\n]",
          "_postman_previewlanguage": "json"
        },
        {
          "name": "400 Bad Request - Dosya Yok",
          "status": "Bad Request",
          "code": 400,
          "body": "Dosya yüklenmedi",
          "_postman_previewlanguage": "text"
        },
        {
          "name": "400 Bad Request - Sayfa Bulunamadı",
          "status": "Bad Request",
          "code": 400,
          "body": "Gerekli sayfalar bulunamadı.",
          "_postman_previewlanguage": "text"
        },
        {
          "name": "500 Internal Server Error",
          "status": "Internal Server Error",
          "code": 500,
          "body": "Sunucu hatası: <hata mesajı>",
          "_postman_previewlanguage": "text"
        }
      ]
    },
    {
      "name": "Get Upload Log",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/excel/log?lines=300",
          "host": ["{{baseUrl}}"],
          "path": ["api", "excel", "log"],
          "query": [
            {
              "key": "lines",
              "value": "300",
              "description": "Dosyanın sondan kaç satırının döneceği (varsayılan 300)"
            }
          ]
        },
        "description": "upload_debug.log dosyasının son satırlarını döner. UploadExcel isteği hâlâ devam ederken veya timeout'a düşse bile, sunucuda en son hangi aşamaya (parse/render/DB connect/insert/commit) kadar gelindiğini görmek için ayrı bir istek olarak çağrılabilir."
      },
      "response": [
        {
          "name": "200 OK - Log içeriği",
          "status": "OK",
          "code": 200,
          "header": [
            {
              "key": "Content-Type",
              "value": "text/plain; charset=utf-8"
            }
          ],
          "body": "30.07.2026 10:50:12.345 - [Request] UploadExcel çağrıldı. Dosya: BAYI KARNE.xlsx, Boyut: 245678 bytes, Type: 5\n30.07.2026 10:50:12.410 - Parse tamamlandı (65ms). İşlenecek kayıt sayısı: 312\n30.07.2026 10:50:12.411 - Render döngüsü başladı.\n30.07.2026 10:50:15.200 - 10/312 kayıt render edildi. Son ID: 00000.12345 (geçen süre: 2789ms)\n30.07.2026 10:52:40.500 - DB: bağlantı açılıyor (conn.Open)...",
          "_postman_previewlanguage": "text"
        },
        {
          "name": "200 OK - Log henüz yok",
          "status": "OK",
          "code": 200,
          "body": "Log dosyası henüz oluşmadı.",
          "_postman_previewlanguage": "text"
        },
        {
          "name": "500 Internal Server Error",
          "status": "Internal Server Error",
          "code": 500,
          "body": "Log okunamadı: <hata mesajı>",
          "_postman_previewlanguage": "text"
        }
      ]
    },
    {
      "name": "Clear Upload Log",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/excel/log/clear",
          "host": ["{{baseUrl}}"],
          "path": ["api", "excel", "log", "clear"]
        },
        "description": "upload_debug.log dosyasının içeriğini temizler."
      },
      "response": [
        {
          "name": "200 OK - Temizlendi",
          "status": "OK",
          "code": 200,
          "body": "Log temizlendi.",
          "_postman_previewlanguage": "text"
        },
        {
          "name": "500 Internal Server Error",
          "status": "Internal Server Error",
          "code": 500,
          "body": "Log temizlenemedi: <hata mesajı>",
          "_postman_previewlanguage": "text"
        }
      ]
    }
  ]
}
